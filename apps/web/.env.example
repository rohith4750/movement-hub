NEXT_PUBLIC_APP_NAME=Movement Hub
# Leave empty: the web app calls its own built-in API at /api/v1
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Backend (runs inside this Next.js app) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movement_hub
# Optional pooled URL for serverless (used first when set)
DATABASE_URL_POOLED=

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/v1/cron/:job
CRON_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CORS_ORIGINS=http://localhost:3000
TIMEZONE_OFFSET=+05:30
